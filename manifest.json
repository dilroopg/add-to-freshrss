{
  "manifest_version": 3,
  "name": "Add to FreshRSS",
  "version": "2.6.0",
  "description": "Right-click a link or page to subscribe a URL you already have to FreshRSS. Not a feed-discovery tool - use RSSHub Radar for that. AI-generated - use at your own risk.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_title": "Add to FreshRSS",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "add-to-freshrss@hardlysleep.ing",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
